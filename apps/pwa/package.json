{
  "name": "@rt/pwa",
  "version": "0.1.0",
  "description": "App de celular (PWA) — grava e transcreve conversas offline no dispositivo.",
  "type": "module",
  "private": true,
  "scripts": {
    "setup:assets": "node ../../packages/web/scripts/copy-assets.mjs public",
