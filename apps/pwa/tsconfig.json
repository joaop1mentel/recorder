{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "baseUrl": ".",
    "paths": {
      "@rt/core": ["../../packages/core/src/index.ts"],
      "@rt/web": ["../../packages/web/src/index.ts"],
      "@rt/web/whisper.worker": ["../../packages/web/src/whisper.worker.ts"]
    }
  },
  "include": ["src"]
}
